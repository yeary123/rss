# Copy to .env on the server and fill in values.
# Domain must resolve to this ECS public IP before first start (Let's Encrypt).

# Hostname only (no https://), must match DNS A record
DOMAIN=rss.example.com

# Miniflux public URL (include https://, no trailing slash)
BASE_URL=https://rss.example.com

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# First-time admin (remove CREATE_ADMIN from docker-compose after first successful login if you prefer)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
